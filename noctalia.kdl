layout {

    focus-ring {
        active-color   "#e46767"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e46767"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#e46767"
        inactive-color "#851414"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e4676780"
    }
}

recent-windows {
    highlight {
        active-color "#e46767"
        urgent-color "#fd4663"
    }
}
