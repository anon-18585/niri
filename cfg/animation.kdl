animations {
        workspace-switch {
        duration-ms 150
    }
        window-open {
            duration-ms 100
            curve "ease-out-quad"
    }
        window-close {
            duration-ms 100
            curve "ease-out-cubic"
    }
        horizontal-view-movement {
        duration-ms 150
    }
        window-movement {
        duration-ms 100
    }
        window-resize {
        duration-ms 150
    }
        config-notification-open-close {
            spring damping-ratio=0.6 stiffness=1200 epsilon=0.001
    }
        screenshot-ui-open {
            duration-ms 150
            curve "ease-out-quad"
    }
        overview-open-close {
            spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    slowdown 1
}
